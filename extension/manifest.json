{
  "manifest_version": 3,
  "name": "ForLater",
  "version": "3.1.0",
  "description": "Save URLs to read later.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "favicon",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
"side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open ForLater",
    "default_icon": "icons/icon48.png"
  }
}